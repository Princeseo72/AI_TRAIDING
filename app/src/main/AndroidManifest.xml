<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />\n    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_pegasus"
        android:roundIcon="@mipmap/ic_launcher_pegasus"
        android:label="PEGASUS 2026"
        android:theme="@style/Theme.HorseRacing">
        <activity
            android:name=".IntroActivity"
            android:exported="true"
            android:theme="@style/Theme.PegasusIntro"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />
    </application>
</manifest>
